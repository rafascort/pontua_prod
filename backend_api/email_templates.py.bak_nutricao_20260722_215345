# /opt/pontua/AutoPonto/backend_api/email_templates.py
"""
Templates de e-mail do ciclo de vida — Sistema Ponto

Mesmo visual dos e-mails de verificação/reset: tabelas com CSS inline,
que é o único jeito de não quebrar no Gmail e no Outlook.

Cada template devolve uma "spec" e o _shell monta o HTML final.

IMPORTANTE: nenhum texto pode sugerir que documentos ou histórico ficam
armazenados. O produto exclui tudo após o download.
"""
from __future__ import annotations
import os

FRONTEND = os.getenv('FRONTEND_URL', 'https://sistemaponto.com')

BG, CARD, LINE, LINE2 = "#0d1117", "#161b22", "#30363d", "#21262d"
ACC, H, P, MUT = "#4a9eff", "#e6edf3", "#8b949e", "#6e7681"
WARM_BG, WARM_LN, WARM = "#1c1410", "#5a3a1f", "#d4924a"

TRIAL_PAGES = 50
PLANOS = {
    'basic':    {'nome': 'Básico',  'paginas': 200,  'preco': 'R$ 179,90', 'extra': 'R$ 1,00'},
    'standard': {'nome': 'Padrão',  'paginas': 500,  'preco': 'R$ 349,90', 'extra': 'R$ 0,85'},
    'premium':  {'nome': 'Premium', 'paginas': 1500, 'preco': 'R$ 824,90', 'extra': 'R$ 0,70'},
}


# ── Helpers de conteúdo ───────────────────────────────────────────────

def _nome(u):
    n = (getattr(u, 'first_name', None) or '').strip()
    return n.split(' ')[0] if n else ''


def _ola(u):
    return _nome(u)


def p(txt, cor=None):
    return (f'<p style="margin:0 0 16px;color:{cor or P};font-size:15px;'
            f'line-height:1.6;">{txt}</p>')


def forte(txt, cor=None):
    return f'<strong style="color:{cor or ACC};">{txt}</strong>'


def btn(texto, url):
    return (f'<table cellpadding="0" cellspacing="0" style="margin:28px auto 8px;">'
            f'<tr><td style="background:linear-gradient(135deg,#1a6bd6,#4a9eff);'
            f'border-radius:8px;"><a href="{url}" style="display:inline-block;'
            f'padding:14px 34px;color:#ffffff;text-decoration:none;font-size:15px;'
            f'font-weight:700;">{texto}</a></td></tr></table>')


def barra(usadas, total, cor=None):
    pct = max(2, min(100, int((usadas / total) * 100))) if total else 2
    c = cor or ACC
    return (f'<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;">'
            f'<tr><td style="padding:0 0 7px;color:{P};font-size:13px;">Usado</td>'
            f'<td align="right" style="padding:0 0 7px;color:{H};font-size:13px;'
            f'font-weight:700;">{usadas}/{total}</td></tr>'
            f'<tr><td colspan="2" style="background:{BG};border:1px solid {LINE};'
            f'border-radius:6px;padding:2px;"><table width="{pct}%" cellpadding="0" '
            f'cellspacing="0"><tr><td style="background:{c};height:8px;'
            f'border-radius:4px;font-size:0;">&nbsp;</td></tr></table>'
            f'</td></tr></table>')


def tabela_planos():
    linhas = ''
    for k in ('basic', 'standard', 'premium'):
        d = PLANOS[k]
        linhas += (f'<tr><td style="padding:12px 15px;border-bottom:1px solid {LINE2};'
                   f'color:{H};font-size:14px;font-weight:600;">{d["nome"]}</td>'
                   f'<td style="padding:12px 15px;border-bottom:1px solid {LINE2};'
                   f'color:{MUT};font-size:13px;">{d["paginas"]} páginas/mês</td>'
                   f'<td align="right" style="padding:12px 15px;border-bottom:1px solid '
                   f'{LINE2};color:{H};font-size:14px;">{d["preco"]}</td></tr>')
    return (f'<table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid '
            f'{LINE};border-radius:8px;margin:0 0 20px;">{linhas}</table>')


def caixa_cupom(codigo, validade=None):
    exp = (f'<p style="margin:10px 0 0;color:{WARM};font-size:13px;">Válido até '
           f'<strong style="color:#f0b877;">{validade}</strong> &middot; uso único</p>'
           ) if validade else ''
    return (f'<table width="100%" cellpadding="0" cellspacing="0" style="background:{WARM_BG};'
            f'border:1px solid {WARM_LN};border-radius:8px;margin:0 0 20px;">'
            f'<tr><td align="center" style="padding:18px;">'
            f'<p style="margin:0 0 9px;color:{WARM};font-size:12px;font-weight:600;'
            f'letter-spacing:.5px;">SEU CUPOM PESSOAL</p>'
            f'<div style="font-size:22px;font-weight:700;color:#e8b877;'
            f'letter-spacing:3px;font-family:monospace;">{codigo}</div>{exp}'
            f'</td></tr></table>')


def numeros(itens):
    tds = ''
    for valor, rotulo in itens:
        tds += (f'<td width="50%" style="padding:6px;"><table width="100%" cellpadding="0" '
                f'cellspacing="0" style="background:{BG};border:1px solid {LINE};'
                f'border-radius:8px;"><tr><td align="center" style="padding:16px 10px;">'
                f'<div style="font-size:22px;font-weight:700;color:{ACC};">{valor}</div>'
                f'<div style="margin-top:6px;color:{MUT};font-size:12px;">{rotulo}</div>'
                f'</td></tr></table></td>')
    return (f'<table width="100%" cellpadding="0" cellspacing="0" '
            f'style="margin:0 0 16px;"><tr>{tds}</tr></table>')


# ── Shell ─────────────────────────────────────────────────────────────

def _shell(spec, unsub_url=None):
    corpo = ''.join(spec.get('body', []))
    if spec.get('cta'):
        corpo += btn(spec['cta'][0], spec['cta'][1])
    if spec.get('rodape_interno'):
        corpo += (f'<p style="margin:16px 0 0;color:{MUT};font-size:13px;'
                  f'text-align:center;">{spec["rodape_interno"]}</p>')

    if spec.get('transacional') or not unsub_url:
        rodape = (f'<p style="margin:0;color:{MUT};font-size:12px;">Sistema Ponto '
                  f'&middot; sistemaponto.com</p>')
    else:
        rodape = (f'<p style="margin:0 0 6px;color:{MUT};font-size:12px;">Sistema Ponto '
                  f'&middot; Arquivos processados temporariamente e excluídos após o '
                  f'download</p>'
                  f'<p style="margin:0;color:{MUT};font-size:12px;">'
                  f'<a href="{unsub_url}" style="color:{MUT};">Não quero mais receber '
                  f'estes e-mails</a></p>')

    return f"""<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:{BG};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:{BG};padding:40px 20px;">
    <tr><td align="center">
      <table width="560" cellpadding="0" cellspacing="0"
             style="background:{CARD};border-radius:12px;border:1px solid {LINE};max-width:560px;width:100%;">
        <tr><td style="background:linear-gradient(135deg,#1a3a5c,#0d2137);padding:32px 40px;text-align:center;">
          <h1 style="margin:0;color:{ACC};font-size:22px;font-weight:700;">Sistema Ponto</h1>
          <p style="margin:8px 0 0;color:#8b9dc3;font-size:13px;">{spec.get('subtitulo','')}</p>
        </td></tr>
        <tr><td style="padding:40px;">
          <h2 style="margin:0 0 18px;color:{H};font-size:20px;">{spec.get('titulo','')}</h2>
          {corpo}
        </td></tr>
        <tr><td style="padding:24px 40px;border-top:1px solid {LINE2};text-align:center;">
          {rodape}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>"""


def _texto(spec):
    linhas = [spec.get('titulo', ''), '']
    linhas.append(spec.get('texto', 'Acesse sistemaponto.com para continuar.'))
    if spec.get('cta'):
        linhas += ['', f"{spec['cta'][0]}: {spec['cta'][1]}"]
    linhas += ['', '-- ', 'Sistema Ponto  |  sistemaponto.com']
    return '\n'.join(linhas)



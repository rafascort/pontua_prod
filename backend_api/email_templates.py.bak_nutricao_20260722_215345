def render(tipo, user, contexto=None, unsub_url=None):
    """Devolve (assunto, html, texto) para um tipo de e-mail."""
    if tipo not in TEMPLATES:
        raise ValueError(f"Template desconhecido: '{tipo}'. "
                         f"Disponíveis: {', '.join(sorted(TEMPLATES))}")
    spec = TEMPLATES[tipo](user, contexto or {})
    return spec['assunto'], _shell(spec, unsub_url), _texto(spec)
